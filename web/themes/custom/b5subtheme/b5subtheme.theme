// /**
//  * Implements hook_preprocess_node(). This code hides the title in card mode
//  */
function b5subtheme_preprocess_node(&$variables) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  
  // Target only the 'article' content type
  if ($node->bundle() === 'profile_page') {
    
    // Target only the 'teaser' view mode
    if ($variables['view_mode'] === 'card') {
      
      // Hide the label/title element inside the teaser template
      $variables['label'] = ''; 
    }
  }
}
