{#
/**
 * @file
 * Theme override for the profile featured image field in card view mode.
 *
 * This template was created specifically to fix layout rendering overrides
 * in Drupal CMS 1.0 (Starshot Layout Builder architecture). It bypasses 
 * complex render array overrides in hook_preprocess_field by safely wrapping 
 * the rendered image in Bootstrap 5 utility classes.
 *
 * Available variables:
 * - items: A list of items containing the field value.
 *   - item.content: The rendered image element.
 *
 * @see b5subtheme_preprocess_field()
 *
 * @ingroup themeable
 */
#}

{% for item in items %}
  <div class="rounded-circle border border-3 border-primary overflow-hidden d-inline-block">
    {{ item.content }}
  </div>
{% endfor %}
